{
  "manifest_version": 3,
  "name": "LiquidityHunter Price Bridge",
  "version": "1.5.0",
  "description": "Streams live price + OHLC + volume from TradingView to the LiquidityHunter app",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["reader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://liquidityhunter.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["writer.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.svg",
    "128": "icon128.svg"
  }
}
