{
  "manifest_version": 3,
  "name": "LiquidityHunter Price Bridge",
  "version": "1.2.0",
  "description": "Streams live NAS100 price from TradingView to the LiquidityHunter app",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://*.tradingview.com/*",
    "https://liquidityhunter.vercel.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["reader.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.svg",
    "128": "icon128.svg"
  }
}
